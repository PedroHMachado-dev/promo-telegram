# Copie este arquivo para .env e preencha somente no seu computador.
# Nunca publique tokens, hashes ou IDs pessoais no GitHub.
BOT_TOKEN=seu_token_do_botfather
CHAT_ID=seu_chat_id_para_receber_alertas
API_ID=seu_api_id_do_telegram
API_HASH=seu_api_hash_do_telegram

# Opcional (usado para deploy na nuvem sem precisar logar via terminal):
TELEGRAM_SESSION_STRING=
PORT=8000
HOST=0.0.0.0
